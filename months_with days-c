#include <stdio.h>

int main() {
    int month;
    
    // Ask user to enter month number
    printf("Enter month number 1-12: ");
    scanf("%d", &month);

    // Check for months with 31 days: Jan, Mar, May, Jul, Aug, Oct, Dec
    if(month == 1 || month == 3 || month == 5 || month == 7 ||
       month == 8 || month == 10 || month == 12) {
        printf("%d month has 31 days\n", month);
    }
    // Check for February
    else if(month == 2) {
        printf("February has 28 or 29 days\n");
    }
    // Check for months with 30 days: Apr, Jun, Sep, Nov
    else if(month == 4 || month == 6 || month == 9 || month == 11) {
        printf("%d month has 30 days\n", month);
    }
    // Invalid input
    else {
        printf("Invalid month. Please enter 1-12\n");
    }

    return 0;
}
